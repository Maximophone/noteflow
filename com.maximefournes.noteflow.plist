<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maximefournes.noteflow</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/maximefournes/code/noteflow/.venv/bin/python</string>
        <string>/Users/maximefournes/code/noteflow/main.py</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/maximefournes/code/noteflow</string>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <!-- Only uncaught output lands here; the app logs to logs/noteflow.log
         via a size-rotated handler (see config/logging_config.py) -->
    <key>StandardOutPath</key>
    <string>/Users/maximefournes/code/noteflow/logs/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/maximefournes/code/noteflow/logs/launchd.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/maximefournes/code/noteflow/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
